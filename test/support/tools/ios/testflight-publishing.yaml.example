# Optional fragment for ios-signed. Add only after signed builds work.
# Requires an App Store Connect app record and completed beta test information.
publishing:
  app_store_connect:
    api_key: $APP_STORE_CONNECT_PRIVATE_KEY
    key_id: $APP_STORE_CONNECT_KEY_IDENTIFIER
    issuer_id: $APP_STORE_CONNECT_ISSUER_ID
    submit_to_testflight: true
    beta_groups:
      - Accounting Testers
    submit_to_app_store: false
